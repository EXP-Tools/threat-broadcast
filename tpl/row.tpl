<tr data-id="%(md5)s">
  <td class="cve-id">%(id)s</td>
  <td class="vuln-title">%(title)s</td>
  <td><span class="severity severity-%(severity_class)s">%(severity)s</span></td>
  <td><span class="source-name">%(source)s</span></td>
  <td class="disclosed-at">%(time)s</td>
  <td><a class="detail-link" target="_blank" rel="noopener noreferrer" href="%(url)s" aria-label="查看原始披露">详情 ↗</a></td>
</tr>
